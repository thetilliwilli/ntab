{
  "manifest_version": 3,
  "name": "Custom New Tab",
  "version": "2.0.0",
  "description": "New tab page with a tabbed plain-text notepad (autosaved to a local folder) and a shortcuts sidebar.",
  "minimum_chrome_version": "122",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon"
  ]
}
