{
  "manifest_version": 3,
  "name": "NTab: Notepad New Tab",
  "short_name": "NTab",
  "version": "2.2.0",
  "description": "Plain-text notepad with tabs, activity tracker, task board and quick links in your new tab. Data stays in your browser.",
  "minimum_chrome_version": "122",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "favicon"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
